# ==============================================================================
# Pegham.ai (پیغام) - Environment Configuration
# ==============================================================================

# Application Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ------------------------------------------------------------------------------
# 100% FREE DEFAULT: Groq Powers BOTH the Brain (LLM) & Speech (Whisper STT)
# Get your free key with 0 credit card required at: https://console.groq.com
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Alternative LLM Providers (Optional)
# ------------------------------------------------------------------------------
# Option A: 100% Offline Local LLM (Ollama)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# Option B: OpenAI (Pay-as-you-go)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_LLM_MODEL=gpt-4o-mini

# Option C: Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure Speech Services (Best for native Urdu / ur-PK TTS and STT)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Alternative TTS Providers (Optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here

# ------------------------------------------------------------------------------
# Pipecat & WebRTC Transport Settings
# ------------------------------------------------------------------------------
# Options: webrtc, daily, websocket
PIPECAT_TRANSPORT=webrtc
# If using Daily.co WebRTC transport:
DAILY_API_KEY=
DAILY_SAMPLE_ROOM_URL=

# ------------------------------------------------------------------------------
# WhatsApp Web Automation Settings
# ------------------------------------------------------------------------------
WHATSAPP_SESSION_DIR=./whatsapp_session
# Set to False to see the browser window during debugging, True for headless
WHATSAPP_HEADLESS=False
WHATSAPP_PAGE_TIMEOUT_MS=60000
